# Server
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-this-to-a-long-random-string

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=cadcs_dispatch_app
DB_PASSWORD=change-this-password
DB_NAME=cadcs_dispatch

# OSRM (self-hosted routing engine)
OSRM_BASE_URL=http://localhost:5000

# Nominatim (self-hosted geocoding, optional convenience search)
NOMINATIM_BASE_URL=http://localhost:8080

# Max login attempts per 15 min per IP before rate limiting kicks in
LOGIN_RATE_LIMIT_MAX=10

# Response time benchmark, seconds (WHO-cited target, §1.1 of proposal)
RESPONSE_TIME_BENCHMARK_SECONDS=480

# Hospital acknowledgment escalation threshold, seconds
HOSPITAL_ACK_ESCALATION_SECONDS=90

# Ambulance signal staleness threshold, seconds
AMBULANCE_STALE_SIGNAL_SECONDS=60
