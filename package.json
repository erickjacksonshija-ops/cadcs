{
  "name": "cadcs",
  "version": "0.1.0",
  "description": "Centralized Ambulance Dispatch & Command System",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node src/db/migrate.js",
    "migrate:test": "node src/db/migrateTest.js",
    "seed": "node src/db/seed.js",
    "seed:demo": "node src/db/seedDemo.js",
    "reseed:demo": "bash scripts/reseed-demo.sh",
    "pretest": "npm run migrate:test",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand test/unit",
    "pretest:integration": "npm run migrate:test",
    "test:integration": "jest --runInBand test/integration",
    "pretest:scenarios": "npm run migrate:test",
    "test:scenarios": "jest --runInBand test/scenarios",
    "lint": "eslint ."
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie": "^0.7.2",
    "cookie-signature": "^1.2.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "express-validator": "^7.2.0",
    "helmet": "^8.3.0",
    "mysql2": "^3.11.0",
    "socket.io": "^4.7.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "globals": "^15.9.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
